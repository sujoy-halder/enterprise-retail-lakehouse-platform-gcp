PROJECT_ID=your-gcp-project-id
PROJECT_NUMBER=123456789012
REGION=us-central1
SECONDARY_REGION=us-east1
ENVIRONMENT=dev
PREFIX=retail-lakehouse
GITHUB_ORG=your-org
GITHUB_REPO=gcp-data-platform

# Created by Terraform outputs after the first apply.
GITHUB_WORKLOAD_IDENTITY_PROVIDER=projects/123456789012/locations/global/workloadIdentityPools/retail-lakehouse-gha/providers/github
GITHUB_DEPLOY_SERVICE_ACCOUNT=retail-lakehouse-gha-deploy@your-gcp-project-id.iam.gserviceaccount.com
ARTIFACT_REGISTRY=us-central1-docker.pkg.dev/your-gcp-project-id/retail-lakehouse-containers
GKE_CLUSTER=retail-lakehouse-dev-gke
GKE_LOCATION=us-central1
BRONZE_BUCKET=retail-lakehouse-dev-bronze-us-central1
SILVER_BUCKET=retail-lakehouse-dev-silver-us-central1
CHECKPOINT_BUCKET=retail-lakehouse-dev-checkpoints-us-central1

# External platforms.
DATABRICKS_HOST=https://adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_TOKEN=replace-with-secret-manager-reference
SNOWFLAKE_ACCOUNT=org-account
SNOWFLAKE_USER=RET_PLATFORM_SVC
SNOWFLAKE_ROLE=RET_PLATFORM_ROLE
SNOWFLAKE_WAREHOUSE=RET_PLATFORM_XS_WH
SNOWFLAKE_DATABASE=RET_ENTERPRISE
