retail_analytics:
  target: "{{ env_var('DBT_TARGET', 'dev') }}"
  outputs:
    dev:
      type: bigquery
      method: oauth
      project: "{{ env_var('GCP_PROJECT_ID') }}"
      dataset: "{{ env_var('DBT_DATASET', 'retail_lakehouse_dev_dbt') }}"
      location: "{{ env_var('BIGQUERY_LOCATION', 'us-central1') }}"
      threads: 4
      job_execution_timeout_seconds: 900
      job_retries: 2
      priority: interactive
    prod:
      type: bigquery
      method: oauth
      project: "{{ env_var('GCP_PROJECT_ID') }}"
      dataset: "{{ env_var('DBT_DATASET', 'retail_lakehouse_prod_dbt') }}"
      location: "{{ env_var('BIGQUERY_LOCATION', 'us-central1') }}"
      threads: 8
      job_execution_timeout_seconds: 1800
      job_retries: 3
      priority: batch

